#!/usr/bin/env bash
# sentinel-autonomy — persistent, mission-driven autonomy for Sentinel OS.
#
# Where sentinel-autopilot / sentinel-agent are one-shot, this keeps working: define
# missions (a goal + optional in-scope target + a cadence) and the local AI pursues them
# on a schedule — monitoring attack surface for drift, running scoped recon, chasing a
# freeform goal via Nexus — then writes an AI status report and alerts you on anything
# that needs attention. Free local model (Ollama), scope-guarded, offline-capable.
#
#   sentinel-autonomy add watch-acme  --goal "watch acme's surface"  --scope acme.com --mode monitor --every 6h
#   sentinel-autonomy add pentest-lab --goal "find a foothold on the lab" --scope 10.0.0.5 --mode active --every 12h
#   sentinel-autonomy add research    --goal "track new CVEs affecting our stack" --mode goal --every 1d
#   sentinel-autonomy list | status | run [name] | once <name> | report [name] | rm <name>
#   sentinel-autonomy daemon            # run missions continuously on their cadence
#   sentinel-autonomy enable | disable  # install/remove the systemd service (persistent autonomy)
#   sentinel-autonomy pause <name> | resume <name> | selfheal
set -uo pipefail
DIR="$HOME/.sentinel/missions"; mkdir -p "$DIR"
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }; g(){ printf '\e[32m%s\e[0m\n' "$*"; }; y(){ printf '\e[33m%s\e[0m\n' "$*"; }; r(){ printf '\e[31m%s\e[0m\n' "$*"; }
now(){ date -u +%s; }
ts(){ date -u +%Y%m%d-%H%M%S; }
dur2s(){ local v="$1"; case "$v" in *d) echo $(( ${v%d}*86400 ));; *h) echo $(( ${v%h}*3600 ));; *m) echo $(( ${v%m}*60 ));; *s) echo $(( ${v%s} ));; *[!0-9]*) echo 21600;; *) echo "$v";; esac; }
human(){ local s=$1; [ "$s" -le 0 ] && { echo now; return; }; if [ "$s" -ge 86400 ]; then echo "$((s/86400))d"; elif [ "$s" -ge 3600 ]; then echo "$((s/3600))h"; elif [ "$s" -ge 60 ]; then echo "$((s/60))m"; else echo "${s}s"; fi; }
conf(){ echo "$DIR/$1.conf"; }
esc(){ printf '%s' "$1" | sed 's/"/\\"/g'; }
notify(){ command -v notify-send >/dev/null 2>&1 && notify-send -u "${2:-normal}" "Sentinel" "$1" 2>/dev/null || true; }

# Best installed model, preferring gpt-oss:120b (OpenAI open-weight, strong agent),
# then :20b, then any capable model. SENTINEL_MODEL wins. Matches Nexus's pick order.
_best_model(){
  local ms; ms="$(ollama list 2>/dev/null | awk 'NR>1{print $1}')"
  local p; for p in "${SENTINEL_MODEL:-}" gpt-oss:120b gpt-oss:20b gpt-oss qwen2.5-coder deepseek-coder llama3.1 llama3.2 hermes3 mistral; do
    [ -n "$p" ] || continue
    local hit; hit="$(printf '%s\n' "$ms" | grep -im1 "^$p")" && [ -n "$hit" ] && { echo "$hit"; return; }
  done
  printf '%s\n' "$ms" | head -1
}
ensure_ai(){
  command -v ollama >/dev/null 2>&1 || return 0
  pgrep -x ollama >/dev/null || (nohup ollama serve >/dev/null 2>&1 &)
  for _ in $(seq 1 20); do ollama list >/dev/null 2>&1 && break; sleep 1; done
  # only auto-pull if NOTHING capable is installed (never surprise-download the 63GB 120b)
  ollama list 2>/dev/null | grep -qiE 'gpt-oss|llama3|qwen|mistral|deepseek|hermes' \
    || { echo "[*] pulling a local model (one-time)…"; ollama pull gpt-oss:20b >/dev/null 2>&1 || ollama pull llama3.2:3b >/dev/null 2>&1 || true; }
  # point every Sentinel tool (sentinel-ai, Nexus) at the best model available
  export SENTINEL_MODEL="${SENTINEL_MODEL:-$(_best_model)}"
}

save_field(){ # save_field <name> <KEY> <value>
  local f; f="$(conf "$1")"; local k="$2" v="$3"
  if grep -q "^$k=" "$f" 2>/dev/null; then sed -i "s#^$k=.*#$k=\"$(esc "$v")\"#" "$f"; else echo "$k=\"$(esc "$v")\"" >> "$f"; fi
}

# ---- the autonomy engine: run one mission if it's due -------------------------
_run_mission(){
  local name="$1" force="${2:-}"
  local f; f="$(conf "$name")"; [ -f "$f" ] || { r "no such mission: $name"; return 1; }
  local GOAL SCOPE MODE EVERY LAST NEXT PAUSED; . "$f"
  [ "${PAUSED:-0}" = 1 ] && [ -z "$force" ] && return 0
  [ -z "$force" ] && [ "$(now)" -lt "${NEXT:-0}" ] && return 0     # not due yet
  local mdir="$DIR/$name"; mkdir -p "$mdir"
  local stamp; stamp="$(ts)"; local rep="$mdir/report-$stamp.md"; local out="$mdir/run-$stamp.log"
  c "▶ mission '$name' ($MODE)${SCOPE:+ → $SCOPE} · $(date -u '+%H:%M:%S')"
  # scope enforcement. ACTIVE (intrusive) missions are fail-CLOSED: the target must be
  # EXPLICITLY authorized (sentinel-scope check), so an empty/undefined scope never lets
  # active testing loose. PASSIVE/monitor use guard (allowed if no scope is defined, but
  # enforced once one is). Either way, no sentinel-scope tool ⇒ active is refused.
  _refuse(){ r "  $1"; echo "REFUSED $(date -u): $2" >> "$mdir/mission.log"; save_field "$name" LAST "$(now)"; save_field "$name" NEXT "$(( $(now) + ${EVERY:-21600} ))"; return 0; }
  if command -v sentinel-scope >/dev/null; then
    if [ "$MODE" = active ]; then
      { [ -n "$SCOPE" ] && sentinel-scope check "$SCOPE" >/dev/null 2>&1; } \
        || { _refuse "refused — active mission needs an explicitly authorized target. Run: sentinel-scope add ${SCOPE:-<target>}" "active target not authorized"; return 0; }
    elif [ -n "$SCOPE" ] && ! sentinel-scope guard "$SCOPE" >/dev/null 2>&1; then
      y "  skipped — $SCOPE is out of scope. Authorize with: sentinel-scope add $SCOPE"
      echo "SKIPPED $(date -u): $SCOPE out of scope" >> "$mdir/mission.log"
      save_field "$name" LAST "$(now)"; save_field "$name" NEXT "$(( $(now) + ${EVERY:-21600} ))"; return 0
    fi
  elif [ "$MODE" = active ]; then
    _refuse "refused — active mission with no scope guard installed (sentinel-scope). Can't verify authorization." "active, no scope guard"; return 0
  fi
  ensure_ai   # bring the local model up now that we know the mission will actually run
  local alert=0 headline=""
  case "$MODE" in
    monitor)   # watch attack surface for drift; changes = alert
      command -v sentinel-watch >/dev/null && sentinel-watch "$SCOPE" --once > "$out" 2>&1 || echo "sentinel-watch unavailable" > "$out"
      if grep -qiE '^\+|new (sub|port|host)|added|appeared' "$out"; then alert=1; headline="surface changed on $SCOPE"; fi ;;
    passive)   # scoped recon (non-destructive) + AI reads the picture
      command -v sentinel-agent >/dev/null && SENTINEL_AGENT_AGGRESSIVE=0 sentinel-agent "$SCOPE" > "$out" 2>&1 \
        || { command -v sentinel-recon >/dev/null && sentinel-recon "$SCOPE" > "$out" 2>&1; } ;;
    active)    # authorized active testing toward the goal
      command -v sentinel-agent >/dev/null && SENTINEL_AGENT_AGGRESSIVE=1 sentinel-agent "$SCOPE" > "$out" 2>&1 \
        || { command -v sentinel >/dev/null && sentinel nexus run "$GOAL (target $SCOPE)" -e ollama > "$out" 2>&1; }
      grep -qiE 'CVE-|vuln|open port|credential|finding' "$out" && { alert=1; headline="findings on $SCOPE"; } ;;
    goal)      # freeform objective — hand it to Nexus autonomously (no fixed target)
      command -v sentinel >/dev/null && sentinel nexus run "$GOAL" -e ollama > "$out" 2>&1 || echo "nexus unavailable" > "$out" ;;
  esac
  # AI writes a short operator-facing status report from the run output
  { echo "# Sentinel autonomy — $name"; echo "_$(date -u)_  ·  mode: $MODE${SCOPE:+  ·  scope: $SCOPE}"; echo; echo "**Goal:** $GOAL"; echo; echo "---"; echo; } > "$rep"
  if command -v sentinel-ai >/dev/null; then
    tail -c 12000 "$out" | sentinel-ai -q -s "You are Sentinel's autonomous operator. From this run output, write a TIGHT status report for the human: (1) what was done, (2) key findings or changes, (3) does the operator need to act now? (yes/no + why), (4) the single best next step. Be concrete; no fluff." "mission goal: $GOAL" >> "$rep" 2>/dev/null || echo "(AI report unavailable — see run log)" >> "$rep"
    grep -qiE '^\s*(3\)|attention|act now).*(yes|urgent|critical)' "$rep" && alert=1
  else echo "(sentinel-ai unavailable — raw output in $out)" >> "$rep"; fi
  echo "$(date -u) ran ($MODE)$([ "$alert" = 1 ] && echo ' · ALERT')" >> "$mdir/mission.log"
  if [ "$alert" = 1 ]; then r "  ⚠ $headline — see: sentinel-autonomy report $name"; notify "⚠ $name: ${headline:-needs attention}" critical
  else g "  ✓ done — report: sentinel-autonomy report $name"; fi
  save_field "$name" LAST "$(now)"; save_field "$name" NEXT "$(( $(now) + ${EVERY:-21600} ))"
}

# ---- commands ------------------------------------------------------------------
cmd="${1:-list}"; [ $# -gt 0 ] && shift

case "$cmd" in
  add)
    NAME="${1:?usage: sentinel-autonomy add <name> --goal ... [--scope t] [--mode monitor|passive|active|goal] [--every 6h]}"; shift
    GOAL=""; SCOPE=""; MODE="passive"; EVERY="6h"
    while [ $# -gt 0 ]; do case "$1" in
      --goal) GOAL="$2"; shift 2;; --scope) SCOPE="$2"; shift 2;;
      --mode) MODE="$2"; shift 2;; --every) EVERY="$2"; shift 2;;
      *) shift;; esac; done
    [ -n "$GOAL" ] || { r "a mission needs --goal \"...\""; exit 1; }
    case "$MODE" in monitor|passive|active|goal) : ;; *) r "mode must be monitor|passive|active|goal"; exit 1;; esac
    { echo "# Sentinel mission: $NAME"; echo "GOAL=\"$(esc "$GOAL")\""; echo "SCOPE=\"$(esc "$SCOPE")\""; echo "MODE=\"$MODE\""; echo "EVERY=\"$(dur2s "$EVERY")\""; echo "LAST=\"0\""; echo "NEXT=\"0\""; echo "PAUSED=\"0\""; } > "$(conf "$NAME")"
    g "✔ mission '$NAME' added — $MODE, every $(human "$(dur2s "$EVERY")")${SCOPE:+, scope $SCOPE}"
    [ -n "$SCOPE" ] && ! { command -v sentinel-scope >/dev/null && sentinel-scope check "$SCOPE" >/dev/null 2>&1; } && y "  note: $SCOPE is not yet authorized — add it:  sentinel-scope add $SCOPE   (active missions refuse out-of-scope)"
    c "  start it:  sentinel-autonomy once $NAME     ·  or run persistently:  sentinel-autonomy enable" ;;

  list)
    shopt -s nullglob; found=0
    c "== Sentinel missions =="
    for f in "$DIR"/*.conf; do found=1; ( . "$f"; nm="$(basename "$f" .conf)"
      due=$(( ${NEXT:-0} - $(now) )); st="$([ "${PAUSED:-0}" = 1 ] && echo paused || { [ "$due" -le 0 ] && echo due || echo "in $(human "$due")"; })"
      printf "  %-16s %-8s every %-5s %-22s %s\n" "$nm" "$MODE" "$(human "${EVERY:-0}")" "${SCOPE:-—}" "$st"
      printf "      ⤷ %s\n" "$GOAL" ); done
    [ "$found" = 0 ] && echo "  (none yet — sentinel-autonomy add <name> --goal \"...\" )"
    echo; c "run: sentinel-autonomy run   ·  persistent: sentinel-autonomy enable" ;;

  status)
    shopt -s nullglob; c "== autonomy status =="
    svc="$(systemctl is-active sentinel-autonomy 2>/dev/null || echo inactive)"
    echo "  daemon (systemd): $svc"
    n=0; for f in "$DIR"/*.conf; do n=$((n+1)); done; echo "  missions: $n"
    echo "  model: $(_best_model 2>/dev/null || echo '—')"
    for f in "$DIR"/*.conf; do ( . "$f"; nm="$(basename "$f" .conf)"; [ "${LAST:-0}" != 0 ] && echo "  · $nm last ran $(human $(( $(now) - LAST ))) ago" ); done; true ;;

  pause)   NAME="${1:?name}"; [ -f "$(conf "$NAME")" ] || { r "no such mission"; exit 1; }; save_field "$NAME" PAUSED 1; y "paused $NAME";;
  resume)  NAME="${1:?name}"; [ -f "$(conf "$NAME")" ] || { r "no such mission"; exit 1; }; save_field "$NAME" PAUSED 0; g "resumed $NAME";;
  rm)      NAME="${1:?name}"; rm -f "$(conf "$NAME")"; rm -rf "${DIR:?}/$NAME"; g "removed $NAME";;

  report)
    NAME="${1:-}"
    if [ -n "$NAME" ]; then ls -1t "$DIR/$NAME"/report-*.md 2>/dev/null | head -1 | xargs -r cat; else
      ls -1t "$DIR"/*/report-*.md 2>/dev/null | head -1 | xargs -r cat; fi
    [ -d "$DIR" ] || echo "(no reports yet)" ;;

  once)    NAME="${1:?usage: sentinel-autonomy once <name>}"; [ -f "$(conf "$NAME")" ] || { r "no such mission"; exit 1; }; _run_mission "$NAME" force ;;

  run)     # run all due missions once (or one named), then exit
    shopt -s nullglob
    if [ -n "${1:-}" ]; then _run_mission "$1"; else
      for f in "$DIR"/*.conf; do nm="$(basename "$f" .conf)"; _run_mission "$nm"; done; fi ;;

  daemon)  # persistent loop — run each mission on its cadence, forever
    c "Sentinel autonomy daemon started · $(date -u)"
    trap 'c "autonomy daemon stopping"; exit 0' INT TERM
    while :; do
      shopt -s nullglob
      for f in "$DIR"/*.conf; do nm="$(basename "$f" .conf)"; _run_mission "$nm"; done
      sleep "${SENTINEL_AUTONOMY_TICK:-60}"
    done ;;

  enable)  # install a systemd service so missions run persistently across reboots
    SVC=/etc/systemd/system/sentinel-autonomy.service
    U="$(id -un)"
    sudo tee "$SVC" >/dev/null <<UNIT
[Unit]
Description=Sentinel OS autonomy engine (mission-driven local-AI operations)
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=$U
Environment=HOME=$HOME
ExecStart=/usr/local/bin/sentinel-autonomy daemon
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
UNIT
    sudo systemctl daemon-reload && sudo systemctl enable --now sentinel-autonomy \
      && g "✔ autonomy daemon enabled — missions now run persistently (systemctl status sentinel-autonomy)" \
      || r "could not enable the service" ;;

  disable) sudo systemctl disable --now sentinel-autonomy 2>/dev/null; sudo rm -f /etc/systemd/system/sentinel-autonomy.service; sudo systemctl daemon-reload 2>/dev/null; y "autonomy daemon disabled" ;;

  selfheal) ensure_ai; g "AI up: $(ollama list 2>/dev/null | awk 'NR==2{print $1}' || echo '—')"; command -v gen-sentinel-menu >/dev/null && sudo gen-sentinel-menu >/dev/null 2>&1; g "toolkit ok"; ;;

  *) echo "usage: sentinel-autonomy {add|list|status|run|once|daemon|report|pause|resume|rm|enable|disable|selfheal}"; exit 0 ;;
esac
