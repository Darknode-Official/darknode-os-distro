#!/usr/bin/env bash
# sentinel-cvewatcher — track products on a CVE watchlist and flag new vulnerabilities
set -uo pipefail
DIR="$HOME/.sentinel/cvewatcher"; mkdir -p "$DIR"
WATCHFILE="$DIR/watchlist.txt"
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }

cmd_add(){
  local product="${1:?usage: sentinel-cvewatcher add <product> [version]}"
  local version="${2:-*}"
  echo "$product|$version" >> "$WATCHFILE"
  g "  Watching: $product $version"
}

cmd_remove(){
  local product="${1:?usage: sentinel-cvewatcher remove <product>}"
  if [ -f "$WATCHFILE" ]; then
    grep -iv "^${product}|" "$WATCHFILE" > "$WATCHFILE.tmp"
    mv "$WATCHFILE.tmp" "$WATCHFILE"
    g "  Removed: $product"
  fi
}

cmd_list(){
  c "Watched Technologies"
  echo ""
  if [ -f "$WATCHFILE" ] && [ -s "$WATCHFILE" ]; then
    while IFS='|' read -r product version; do
      echo "  $product ($version)"
    done < "$WATCHFILE"
  else
    dim "  No technologies watched. Add with: sentinel-cvewatcher add <product> [version]"
  fi
}

cmd_scan(){
  c "Scanning for CVEs..."
  [ -f "$WATCHFILE" ] || { y "  No watchlist. Add products first."; return; }
  echo ""
  while IFS='|' read -r product version; do
    [ -n "$product" ] || continue
    printf "  %-20s " "$product"
    local encoded=$(python3 -c "import urllib.parse;print(urllib.parse.quote('$product'))" 2>/dev/null || echo "$product")
    local resp=$(curl -s "https://services.nvd.nist.gov/rest/json/cves/2.0?keywordSearch=$encoded&resultsPerPage=5" 2>/dev/null)
    local count=$(echo "$resp" | python3 -c "import sys,json;d=json.load(sys.stdin);print(d.get('totalResults',0))" 2>/dev/null || echo "?")
    if [ "$count" != "0" ] && [ "$count" != "?" ]; then
      r "$count CVEs found"
      echo "$resp" | python3 -c "
import sys,json
d=json.load(sys.stdin)
for v in d.get('vulnerabilities',[])[:3]:
    cve = v.get('cve',{})
    cid = cve.get('id','?')
    desc = cve.get('descriptions',[{}])[0].get('value','')[:80] if cve.get('descriptions') else ''
    metrics = cve.get('metrics',{})
    score = '?'
    for k in ['cvssMetricV31','cvssMetricV30','cvssMetricV2']:
        if k in metrics:
            score = metrics[k][0].get('cvssData',{}).get('baseScore','?')
            break
    print(f'    {cid} (CVSS {score}) {desc}')
" 2>/dev/null
    else
      g "no new CVEs"
    fi
  done < "$WATCHFILE"
}

cmd_report(){
  c "CVE Vulnerability Report"
  echo "Generated: $(date -u)"
  echo ""
  cmd_scan
}

usage(){ cat << 'U'
  sentinel-cvewatcher — monitor CVEs for your target's tech stack

  Commands:
    add <product> [ver]  Add technology to watchlist
    remove <product>     Remove from watchlist
    list                 Show watchlist
    scan                 Check NVD for new CVEs
    report               Generate vulnerability report
U
}

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  add) cmd_add "$@" ;; remove) cmd_remove "$@" ;; list) cmd_list ;;
  scan) cmd_scan ;; report) cmd_report ;; help|--help|-h) usage ;;
  *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
