#!/usr/bin/env bash
set -uo pipefail
# sentinel-ghost-recon — zero-touch passive recon.
# NEVER sends a single packet to the target. Uses only public databases,
# caches, and third-party APIs. Proves zero contact with a tcpdump check.
#
#   sentinel-ghost-recon target example.com   — full zero-touch recon
#   sentinel-ghost-recon quick example.com    — fast summary
#   sentinel-ghost-recon verify               — prove no packets were sent

DIR="$HOME/.sentinel/ghost-recon"
mkdir -p "$DIR"

c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }
hr(){ printf '\e[2m%s\e[0m\n' "$(printf '─%.0s' $(seq 1 60))"; }

PCAP_FILE="$DIR/ghost-verify.pcap"

_start_verify(){
  local target="$1"
  # Resolve target IP for verification (using a cached/system resolver)
  local target_ip
  target_ip=$(getent ahostsv4 "$target" 2>/dev/null | head -1 | awk '{print $1}')
  echo "$target_ip" > "$DIR/.target_ip"
  # Start tcpdump in background to prove we send nothing
  sudo tcpdump -i any -w "$PCAP_FILE" "host $target_ip" -c 1000 2>/dev/null &
  echo "$!" > "$DIR/.tcpdump_pid"
  dim "  Verification capture started (PID $(cat "$DIR/.tcpdump_pid"))"
}

_stop_verify(){
  local pid
  pid=$(cat "$DIR/.tcpdump_pid" 2>/dev/null)
  [ -n "$pid" ] && sudo kill "$pid" 2>/dev/null
  rm -f "$DIR/.tcpdump_pid"
}

cmd_target(){
  local target="${1:?usage: sentinel-ghost-recon target <domain>}"
  local stamp=$(date +%Y%m%d-%H%M%S)
  local report="$DIR/ghost-${target}-${stamp}.md"

  c "Ghost Recon — Zero-Touch Intelligence"
  dim "Target: $target"
  dim "Mode: PASSIVE ONLY (no packets to target)"
  hr

  _start_verify "$target"

  {
    echo "# Ghost Recon Report: $target"
    echo "_$(date -u) — zero-touch passive intelligence_"
    echo ""

    echo "## 1. WHOIS (via public WHOIS servers)"
    echo '```'
    whois "$target" 2>/dev/null | grep -iE "registrant|admin.*name|tech.*name|created|expir|nameserver|org" | head -20
    echo '```'
    echo ""

    echo "## 2. DNS Records (via public resolvers)"
    echo '```'
    for rt in A AAAA MX NS TXT SOA CNAME; do
      result=$(dig +short "$target" "$rt" @8.8.8.8 2>/dev/null)
      [ -n "$result" ] && echo "$rt: $result"
    done
    echo '```'
    echo ""

    echo "## 3. Certificate Transparency (via crt.sh)"
    echo '```'
    curl -s "https://crt.sh/?q=%25.$target&output=json" 2>/dev/null | \
      python3 -c "import sys,json;[print(e.get('name_value','')) for e in json.load(sys.stdin)]" 2>/dev/null | \
      sort -u | head -30
    echo '```'
    echo ""

    echo "## 4. Web Archive (via Wayback Machine CDX API)"
    echo '```'
    curl -s "http://web.archive.org/cdx/search/cdx?url=$target/*&output=text&fl=original&collapse=urlkey&limit=30" 2>/dev/null | head -30
    echo '```'
    echo ""

    echo "## 5. HTTP Headers (via Google Cache / Wayback)"
    echo '```'
    curl -s "https://webcache.googleusercontent.com/search?q=cache:$target" 2>/dev/null | \
      grep -ioE '<meta[^>]+(description|keywords|generator|author)[^>]+>' | head -10
    echo '```'
    echo ""

    echo "## 6. Technology Stack (via public databases)"
    echo '```'
    # BuiltWith-style: check common technology indicators from cached pages
    curl -s "https://webcache.googleusercontent.com/search?q=cache:$target" 2>/dev/null | \
      grep -ioE '(wordpress|drupal|joomla|react|angular|vue|jquery|bootstrap|nginx|apache|cloudflare|aws|azure|google cloud)' | \
      sort -u
    echo '```'
    echo ""

    echo "## 7. Email Addresses (via public sources)"
    echo '```'
    # Search for emails in cached content
    curl -s "https://webcache.googleusercontent.com/search?q=cache:$target+%22@$target%22" 2>/dev/null | \
      grep -ioE "[a-zA-Z0-9._%+-]+@$target" | sort -u | head -20
    echo '```'
    echo ""

    echo "## 8. Shodan (via public search — no API key needed for basic)"
    echo '```'
    curl -s "https://internetdb.shodan.io/$(dig +short "$target" @8.8.8.8 2>/dev/null | head -1)" 2>/dev/null | \
      python3 -c "import sys,json;d=json.load(sys.stdin);print('Ports:',d.get('ports',[]));print('Vulns:',d.get('vulns',[]));print('Hostnames:',d.get('hostnames',[]))" 2>/dev/null
    echo '```'
    echo ""

    echo "## 9. SecurityTrails / Passive DNS"
    echo '```'
    # Check if any passive DNS data is publicly accessible
    curl -s "https://api.hackertarget.com/dnslookup/?q=$target" 2>/dev/null | head -15
    echo '```'
    echo ""

    echo "---"
    echo "_All data gathered from public databases only. Zero packets sent to target._"
  } | tee "$report"

  _stop_verify

  echo ""
  g "Report saved: $report"
  dim "Verify zero contact: sentinel-ghost-recon verify"
}

cmd_quick(){
  local target="${1:?usage: sentinel-ghost-recon quick <domain>}"
  c "Ghost Recon — Quick Summary"
  dim "Target: $target (passive only)"
  hr

  echo ""
  c "DNS:"
  dig +short "$target" A @8.8.8.8 2>/dev/null | sed 's/^/  /'
  dig +short "$target" MX @8.8.8.8 2>/dev/null | sed 's/^/  MX: /'

  echo ""
  c "Subdomains (crt.sh):"
  curl -s "https://crt.sh/?q=%25.$target&output=json" 2>/dev/null | \
    python3 -c "import sys,json;[print('  '+e.get('name_value','')) for e in json.load(sys.stdin)[:10]]" 2>/dev/null

  echo ""
  c "Shodan:"
  local ip=$(dig +short "$target" @8.8.8.8 2>/dev/null | head -1)
  [ -n "$ip" ] && curl -s "https://internetdb.shodan.io/$ip" 2>/dev/null | \
    python3 -c "import sys,json;d=json.load(sys.stdin);print('  Ports:',d.get('ports',[]));print('  Vulns:',d.get('vulns',[]))" 2>/dev/null

  echo ""
  c "WHOIS Registrant:"
  whois "$target" 2>/dev/null | grep -i "registrant.*org\|registrant.*name" | head -2 | sed 's/^/  /'
}

cmd_verify(){
  c "Ghost Recon — Zero Contact Verification"
  hr

  if [ ! -f "$PCAP_FILE" ]; then
    y "No verification capture found. Run 'sentinel-ghost-recon target <domain>' first."
    return 0
  fi

  local target_ip=$(cat "$DIR/.target_ip" 2>/dev/null)
  local packets=$(sudo tcpdump -r "$PCAP_FILE" 2>/dev/null | wc -l)

  echo ""
  if [ "$packets" -eq 0 ]; then
    g "  VERIFIED: Zero packets sent to $target_ip"
    g "  The reconnaissance was fully passive."
  else
    r "  WARNING: $packets packets were captured to/from $target_ip"
    r "  Some tools may have made direct contact."
    echo ""
    echo "  Packet details:"
    sudo tcpdump -r "$PCAP_FILE" -nn 2>/dev/null | head -10 | sed 's/^/    /'
  fi

  echo ""
  dim "Capture file: $PCAP_FILE"
}

usage(){
  cat << 'USAGE'

  sentinel-ghost-recon — zero-touch passive reconnaissance

  Commands:
    target <domain>   Full passive recon (no packets to target)
    quick <domain>    Fast summary
    verify            Prove zero packets were sent (tcpdump check)

  Every data source used is a public database or cache.
  The target never knows it was investigated.

USAGE
}

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  target)  cmd_target "$@" ;;
  quick)   cmd_quick "$@" ;;
  verify)  cmd_verify ;;
  help|--help|-h) usage ;;
  *)       r "Unknown: $cmd"; usage; exit 1 ;;
esac
