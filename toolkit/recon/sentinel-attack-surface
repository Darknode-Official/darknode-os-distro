#!/usr/bin/env bash
set -uo pipefail
# sentinel-attack-surface — map a target's external attack surface
# Maps complete attack surface into a structured risk-scored inventory.
# Combines subdomains, ports, services, technologies, and CVEs. Original tool.

DIR="$HOME/.sentinel/surface"; mkdir -p "$DIR"
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }
bold(){ printf '\e[1m%s\e[0m\n' "$*"; }

_risk_score(){
  local port="$1" svc="$2"
  local score=10 # base

  # Internet-facing web = higher risk
  case "$port" in
    80|443|8080|8443) score=$((score+20)) ;;
    22)               score=$((score+15)) ;;
    21)               score=$((score+25)) ;; # FTP is high risk
    445|139)          score=$((score+30)) ;; # SMB is very high risk
    3389)             score=$((score+25)) ;; # RDP
    3306|5432|1433)   score=$((score+30)) ;; # exposed DB
    6379|27017)       score=$((score+35)) ;; # Redis/Mongo often noauth
    23)               score=$((score+35)) ;; # Telnet
    161)              score=$((score+20)) ;; # SNMP
  esac

  # Service-specific adjustments
  case "$svc" in
    *ftp*)    score=$((score+10)) ;;
    *telnet*) score=$((score+15)) ;;
    *http*)   score=$((score+5)) ;;
  esac

  [ $score -gt 100 ] && score=100
  echo $score
}

cmd_map(){
  local target="${1:?usage: sentinel-attack-surface map <domain>}"
  local stamp=$(date +%Y%m%d-%H%M%S)
  local report="$DIR/surface-${target}-${stamp}.md"
  local data="$DIR/surface-${target}-${stamp}.json"

  c "Mapping attack surface: $target"
  dim "This takes 2-5 minutes..."
  echo ""

  {
    echo "# Attack Surface Map: $target"
    echo "_Generated $(date -u) by Sentinel OS_"
    echo ""

    # 1. Subdomains
    bold "1. Subdomain enumeration..." >&2
    echo "## Subdomains"
    echo ""
    local subs=$(timeout 20 curl -s "https://crt.sh/?q=%25.$target&output=json" 2>/dev/null | python3 -c "
import sys,json
try:
    seen=set()
    for e in json.load(sys.stdin):
        for n in e.get('name_value','').split('\n'):
            n=n.strip().lower()
            if n and n not in seen and '*' not in n:
                seen.add(n)
                print(n)
except: pass
" 2>/dev/null | sort -u)

    local sub_count=0
    if [ -n "$subs" ]; then
      sub_count=$(echo "$subs" | wc -l)
      echo "Found $sub_count subdomains:"
      echo ""
      echo '```'
      echo "$subs"
      echo '```'
    else
      echo "No subdomains found via crt.sh"
    fi
    echo ""

    # 2. IP Resolution
    bold "2. Resolving IPs..." >&2
    echo "## IP Addresses"
    echo ""
    echo "| Subdomain | IP |"
    echo "|-----------|-----|"
    local ips_file=$(mktemp)
    echo "$target" > "$ips_file"
    dig +short "$target" A 2>/dev/null | head -5 | while read -r ip; do
      echo "| $target | $ip |"
    done
    if [ -n "$subs" ]; then
      echo "$subs" | head -20 | while read -r sub; do
        local ip=$(timeout 3 dig +short "$sub" A 2>/dev/null | head -1)
        [ -n "$ip" ] && echo "| $sub | $ip |"
      done
    fi
    echo ""

    # 3. Port scanning
    bold "3. Port scanning..." >&2
    echo "## Open Ports & Services"
    echo ""
    local primary_ip=$(dig +short "$target" A 2>/dev/null | head -1)
    if [ -n "$primary_ip" ] && command -v nmap >/dev/null 2>&1; then
      echo "### $target ($primary_ip)"
      echo ""
      echo '```'
      timeout 30 nmap -sV --top-ports 50 -T4 "$primary_ip" 2>/dev/null | grep -E "open|filtered" | head -20
      echo '```'
      echo ""
    fi

    # 4. Risk scoring
    bold "4. Risk scoring..." >&2
    echo "## Risk Assessment"
    echo ""
    echo "| Asset | Port | Service | Risk Score |"
    echo "|-------|------|---------|------------|"

    if [ -n "$primary_ip" ]; then
      timeout 20 nmap -sV --top-ports 30 -T4 "$primary_ip" 2>/dev/null | grep "open" | while read -r line; do
        local port=$(echo "$line" | awk -F/ '{print $1}')
        local svc=$(echo "$line" | awk '{print $3}')
        local score=$(_risk_score "$port" "$svc")
        local risk_label="LOW"
        [ "$score" -ge 40 ] && risk_label="MEDIUM"
        [ "$score" -ge 60 ] && risk_label="HIGH"
        [ "$score" -ge 80 ] && risk_label="CRITICAL"
        echo "| $target | $port | $svc | $score/100 ($risk_label) |"
      done
    fi
    echo ""

    # 5. Technology detection
    bold "5. Technology detection..." >&2
    echo "## Technology Stack"
    echo ""
    echo '```'
    timeout 10 curl -sI "https://$target" 2>/dev/null | grep -iE "^server:|^x-powered|^x-generator|^set-cookie" | head -10
    echo '```'
    echo ""

    # 6. Summary
    echo "## Summary"
    echo ""
    echo "| Metric | Value |"
    echo "|--------|-------|"
    echo "| Subdomains | $sub_count |"
    echo "| Primary IP | ${primary_ip:-unknown} |"
    echo "| Open ports | $(timeout 10 nmap --top-ports 30 "$primary_ip" 2>/dev/null | grep -c 'open' || echo '?') |"
    echo ""

    echo "## Recommended Attack Priority"
    echo ""
    echo "1. Enumerate all $sub_count subdomains for web applications"
    echo "2. Test each for default credentials and known CVEs"
    echo "3. Check for exposed databases and admin panels"
    echo "4. Test SSL/TLS configuration"
    echo "5. Search for leaked credentials"
    echo ""
    echo "---"
    echo "_Generated by Sentinel OS Attack Surface Mapper_"

  } > "$report" 2>/dev/null

  echo ""
  g "Attack surface report: $report"
  echo "  $(wc -l < "$report") lines"
  dim "View: less $report"
}

cmd_score(){
  local target="${1:?usage: sentinel-attack-surface score <domain_or_ip>}"
  c "Quick Risk Score: $target"
  echo ""

  local ip=$(dig +short "$target" A 2>/dev/null | head -1)
  [ -z "$ip" ] && ip="$target"

  bold "Scanning..."
  local total_score=0 count=0

  timeout 20 nmap -sV --top-ports 20 -T4 "$ip" 2>/dev/null | grep "open" | while read -r line; do
    local port=$(echo "$line" | awk -F/ '{print $1}')
    local svc=$(echo "$line" | awk '{print $3}')
    local score=$(_risk_score "$port" "$svc")
    local color="\e[32m"
    [ "$score" -ge 40 ] && color="\e[33m"
    [ "$score" -ge 60 ] && color="\e[31m"
    printf "  %-6s %-14s ${color}%d/100\e[0m\n" "$port" "$svc" "$score"
  done
}

cmd_diff(){
  local old="${1:?usage: sentinel-attack-surface diff <old_report.md>}"
  [ -f "$old" ] || { r "File not found: $old"; return 1; }

  c "Surface Diff"
  y "Compare with: sentinel-attack-surface map, then diff the two .md files"
  dim "Use: diff $old <new_report.md>"
}

cmd_prioritize(){
  c "Attack Priority Ranking"
  echo ""
  bold "By service risk (highest first):"
  echo "  1. Exposed databases (3306, 5432, 1433, 6379, 27017) — often noauth"
  echo "  2. SMB/NetBIOS (445, 139) — EternalBlue, relay, null session"
  echo "  3. Telnet (23) — cleartext, often default creds"
  echo "  4. FTP (21) — anonymous upload, cleartext"
  echo "  5. RDP (3389) — BlueKeep, brute force"
  echo "  6. SSH (22) — brute force, key theft"
  echo "  7. Web apps (80, 443, 8080) — SQLi, XSS, SSRF"
  echo "  8. SNMP (161) — community string leak"
  echo ""
  dim "Run: sentinel-attack-surface map <target> for a full ranked report"
}

usage(){
  cat << 'USAGE'

  sentinel-attack-surface — Attack Surface Mapper

  Commands:
    map <domain>          Full attack surface report with risk scores
    score <domain_or_ip>  Quick per-port risk scoring
    diff <old_report.md>  Compare surface changes
    prioritize            Show attack priority ranking

USAGE
}

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  map)        cmd_map "$@" ;;
  score)      cmd_score "$@" ;;
  diff)       cmd_diff "$@" ;;
  prioritize) cmd_prioritize ;;
  help|--help|-h) usage ;;
  *)          r "Unknown: $cmd"; usage; exit 1 ;;
esac
