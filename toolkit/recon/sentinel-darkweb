#!/usr/bin/env bash
set -uo pipefail
DIR="$HOME/.sentinel/darkweb"; mkdir -p "$DIR"
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }
ts(){ date -u +%Y%m%d-%H%M%S; }

_tor_check(){
  if ! pgrep -x tor >/dev/null 2>&1; then
    y "  Tor is not running. Start with: sudo systemctl start tor"
    return 1
  fi
  return 0
}

cmd_search(){
  local query="${1:?usage: sentinel-darkweb search <target>}"
  c "Dark Web Search: $query"
  echo ""
  # Ahmia (clearnet gateway to .onion)
  echo "  Searching Ahmia.fi..."
  local results=$(curl -s "https://ahmia.fi/search/?q=$(python3 -c "import urllib.parse;print(urllib.parse.quote('$query'))")" 2>/dev/null | grep -oP 'href="[^"]*\.onion[^"]*"' | head -10)
  if [ -n "$results" ]; then
    echo "$results" | sed 's/href="//;s/"//' | sed 's/^/    /'
    echo "  Found $(echo "$results" | wc -l) .onion references"
  else
    dim "  No results from Ahmia."
  fi
  echo ""
  # IntelX (if API key available)
  local intelx_key="${INTELX_API_KEY:-}"
  if [ -n "$intelx_key" ]; then
    echo "  Searching IntelX..."
    curl -s -H "x-key: $intelx_key" "https://2.intelx.io/intelligent/search" \
      -d "{\"term\":\"$query\",\"maxresults\":10,\"media\":0,\"sort\":2,\"terminate\":[]}" 2>/dev/null | \
      python3 -c "import sys,json;d=json.load(sys.stdin);print(f'  Found {d.get(\"records\",0)} records')" 2>/dev/null
  else
    dim "  IntelX: set INTELX_API_KEY for deep web search"
  fi
  echo "$(ts) search $query" >> "$DIR/searches.log"
}

cmd_paste(){
  local query="${1:?usage: sentinel-darkweb paste <target>}"
  c "Paste Site Search: $query"
  echo ""
  echo "  Searching paste sites..."
  # Check common paste aggregators
  for site in "https://psbdmp.ws/api/search/$query" "https://snippets.glot.io/search?q=$query"; do
    local resp=$(curl -s --max-time 10 "$site" 2>/dev/null | head -500)
    [ -n "$resp" ] && echo "  Results from $(echo "$site" | cut -d/ -f3):" && echo "$resp" | head -5 | sed 's/^/    /'
  done
  dim "  Also check: pastebin.com, ghostbin, dpaste manually"
}

cmd_creds(){
  local target="${1:?usage: sentinel-darkweb creds <target>}"
  c "Credential Leak Search: $target"
  echo ""
  y "  Checking breach databases..."
  if command -v h8mail >/dev/null 2>&1; then
    h8mail -t "@$target" 2>/dev/null | grep -E "Found|Target|\\[" | head -15 | sed 's/^/    /'
  else
    dim "  Install h8mail: pip3 install h8mail"
  fi
  echo ""
  dim "  Also check: dehashed.com, leakcheck.io, snusbase.com"
}

cmd_monitor(){
  local target="${1:?usage: sentinel-darkweb monitor <target>}"
  echo "$target" >> "$DIR/monitors.txt"
  g "  Monitoring: $target"
  dim "  Run 'sentinel-darkweb search $target' periodically to check for new mentions."
}

cmd_report(){
  c "Dark Web Exposure Report"
  echo ""
  if [ -f "$DIR/searches.log" ]; then
    echo "  Recent searches:"
    tail -10 "$DIR/searches.log" | sed 's/^/    /'
  fi
  if [ -f "$DIR/monitors.txt" ]; then
    echo ""
    echo "  Active monitors:"
    cat "$DIR/monitors.txt" | sed 's/^/    /'
  fi
}

usage(){ cat << 'U'
  sentinel-darkweb — dark web intelligence gathering

  Commands:
    search <query>     Search dark web via Ahmia + IntelX
    paste <target>     Search paste sites for leaks
    creds <domain>     Search for leaked credentials
    monitor <target>   Add to monitoring list
    report             Show dark web exposure report

  Optional:
    INTELX_API_KEY     For deep Intelligence X searches
    Tor must be running for .onion access
U
}
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  search) cmd_search "$@" ;; paste) cmd_paste "$@" ;; creds) cmd_creds "$@" ;;
  monitor) cmd_monitor "$@" ;; report) cmd_report ;; help|--help|-h) usage ;;
  *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
