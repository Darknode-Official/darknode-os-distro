#!/usr/bin/env bash
# sentinel-tools — discover and launch the Sentinel custom toolkit.
#   sentinel-tools               overview: tool counts by category
#   sentinel-tools list          list every Sentinel tool with a one-line description
#   sentinel-tools <category>    list one category (recon exploit post defense util)
#   sentinel-tools search <q>    fuzzy-search names and descriptions
#   sentinel-tools info <tool>   show a tool's description + install status
#   sentinel-tools run <tool> …  run a tool by name (passes remaining args)
set -uo pipefail

c(){ printf '\e[1;36m%s\e[0m' "$*"; }
g(){ printf '\e[32m%s\e[0m' "$*"; }
r(){ printf '\e[31m%s\e[0m' "$*"; }
y(){ printf '\e[33m%s\e[0m' "$*"; }
dim(){ printf '\e[2m%s\e[0m' "$*"; }

# Registry: name|category  (generated from the toolkit source tree)
REG=(
"sentinel-ad|post-exploit"
"sentinel-agent|post-exploit"
"sentinel-ai|util"
"sentinel-anon|defense"
"sentinel-apifuzz|exploit"
"sentinel-arsenal|util"
