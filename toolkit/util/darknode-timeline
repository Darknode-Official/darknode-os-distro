#!/usr/bin/env bash
set -uo pipefail
# darknode-timeline — record an attack timeline of your actions
# Records and replays penetration testing sessions with timestamps,
# milestones, and terminal state captures. Original tool.

DIR="$HOME/.darknode/timelines"; mkdir -p "$DIR"
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }
bold(){ printf '\e[1m%s\e[0m\n' "$*"; }

ACTIVE_FILE="$DIR/.active_engagement"

cmd_start(){
  local name="${1:?usage: darknode-timeline start <engagement-name>}"
  local safe_name=$(echo "$name" | tr ' ' '-' | tr -cd 'a-zA-Z0-9_-')
  local eng_dir="$DIR/$safe_name"

  if [ -f "$ACTIVE_FILE" ]; then
    local current=$(cat "$ACTIVE_FILE")
    r "Already recording: $current"
    echo "  Stop it first: darknode-timeline stop"
    return 1
  fi

  mkdir -p "$eng_dir"
  echo "$safe_name" > "$ACTIVE_FILE"

  # Init metadata
  {
    echo "engagement: $name"
    echo "started: $(date -u)"
    echo "started_epoch: $(date +%s)"
    echo "user: $(whoami)"
    echo "hostname: $(hostname)"
    echo "ip: $(hostname -I 2>/dev/null | awk '{print $1}')"
  } > "$eng_dir/meta.txt"

  # Start the typescript recording
  > "$eng_dir/commands.log"
  > "$eng_dir/milestones.log"

  # Set up command logging via PROMPT_COMMAND
  export DARKNODE_TIMELINE_DIR="$eng_dir"
  export DARKNODE_TIMELINE_START=$(date +%s)

  # Install the prompt hook
  local hook_file="$eng_dir/.hook.sh"
  cat > "$hook_file" << 'HOOK'
_darknode_timeline_log() {
  local cmd=$(history 1 | sed 's/^[ ]*[0-9]*[ ]*//')
  local elapsed=$(( $(date +%s) - ${DARKNODE_TIMELINE_START:-0} ))
  local ts=$(date '+%H:%M:%S')
  echo "[$ts +${elapsed}s] $cmd" >> "${DARKNODE_TIMELINE_DIR}/commands.log" 2>/dev/null
}
PROMPT_COMMAND="_darknode_timeline_log;${PROMPT_COMMAND:-}"
HOOK

  g "Recording started: $name"
  echo "  Directory: $eng_dir"
  echo ""
  echo "  Commands:"
  echo "    darknode-timeline mark \"milestone\"    add a milestone"
  echo "    darknode-timeline screenshot           capture terminal"
  echo "    darknode-timeline stop                 stop recording"
  echo ""
  y "  To activate logging in THIS shell, run:"
  echo "    source $hook_file"
  echo ""
  dim "  (New terminals auto-activate if .bashrc hook is installed)"
}

cmd_mark(){
  local note="${1:?usage: darknode-timeline mark <note>}"
  if [ ! -f "$ACTIVE_FILE" ]; then
    r "No active recording. Start one: darknode-timeline start <name>"
    return 1
  fi

  local eng=$(cat "$ACTIVE_FILE")
  local eng_dir="$DIR/$eng"
  local ts=$(date '+%Y-%m-%d %H:%M:%S')
  local elapsed=0
  local start_epoch=$(grep "started_epoch:" "$eng_dir/meta.txt" 2>/dev/null | awk '{print $2}')
  [ -n "$start_epoch" ] && elapsed=$(( $(date +%s) - start_epoch ))

  echo "[$ts +${elapsed}s] $note" >> "$eng_dir/milestones.log"
  g "Milestone: $note (+${elapsed}s)"
}

cmd_screenshot(){
  if [ ! -f "$ACTIVE_FILE" ]; then
    r "No active recording."
    return 1
  fi

  local eng=$(cat "$ACTIVE_FILE")
  local eng_dir="$DIR/$eng"
  local stamp=$(date +%H%M%S)
  local ss_file="$eng_dir/screenshot-${stamp}.txt"

  # Capture terminal content
  {
    echo "=== Terminal Screenshot: $(date) ==="
    echo "=== User: $(whoami)@$(hostname) ==="
    echo "=== CWD: $(pwd) ==="
    echo ""
    # Capture recent history
    history 2>/dev/null | tail -20
    echo ""
    echo "=== Active connections ==="
    ss -tn state established 2>/dev/null | head -10
    echo ""
    echo "=== Running processes ==="
    ps aux --no-headers 2>/dev/null | grep -vE 'ps aux|grep' | tail -15
  } > "$ss_file"

  g "Screenshot saved: $ss_file"
}

cmd_stop(){
  if [ ! -f "$ACTIVE_FILE" ]; then
    r "No active recording."
    return 1
  fi

  local eng=$(cat "$ACTIVE_FILE")
  local eng_dir="$DIR/$eng"

  # Record end time
  echo "ended: $(date -u)" >> "$eng_dir/meta.txt"
  local start_epoch=$(grep "started_epoch:" "$eng_dir/meta.txt" 2>/dev/null | awk '{print $2}')
  local duration=0
  [ -n "$start_epoch" ] && duration=$(( $(date +%s) - start_epoch ))
  echo "duration_seconds: $duration" >> "$eng_dir/meta.txt"

  rm -f "$ACTIVE_FILE"

  # Clean up prompt hook
  unset DARKNODE_TIMELINE_DIR DARKNODE_TIMELINE_START 2>/dev/null

  local cmd_count=$(wc -l < "$eng_dir/commands.log" 2>/dev/null || echo 0)
  local mile_count=$(wc -l < "$eng_dir/milestones.log" 2>/dev/null || echo 0)
  local ss_count=$(ls "$eng_dir"/screenshot-*.txt 2>/dev/null | wc -l)

  g "Recording stopped: $eng"
  echo "  Duration: $((duration/60))m ${duration}s"
  echo "  Commands: $cmd_count"
  echo "  Milestones: $mile_count"
  echo "  Screenshots: $ss_count"
  dim "  Export: darknode-timeline export $eng"
}

cmd_replay(){
  local eng="${1:?usage: darknode-timeline replay <engagement>}"
  local eng_dir="$DIR/$eng"
  [ -d "$eng_dir" ] || { r "Engagement not found: $eng"; return 1; }

  c "Replaying: $eng"
  dim "Press Ctrl+C to stop"
  echo ""

  # Show metadata
  bold "Engagement Info:"
  cat "$eng_dir/meta.txt" | sed 's/^/  /'
  echo ""

  # Show milestones interleaved with commands
  bold "Timeline:"
  echo ""

  if [ -f "$eng_dir/milestones.log" ] && [ -s "$eng_dir/milestones.log" ]; then
    while IFS= read -r line; do
      printf "  \e[33m>>> %s\e[0m\n" "$line"
    done < "$eng_dir/milestones.log"
    echo ""
  fi

  if [ -f "$eng_dir/commands.log" ] && [ -s "$eng_dir/commands.log" ]; then
    bold "Commands:"
    while IFS= read -r line; do
      printf "  \e[2m%s\e[0m\n" "$line"
    done < "$eng_dir/commands.log"
  fi
}

cmd_export(){
  local eng="${1:?usage: darknode-timeline export <engagement>}"
  local eng_dir="$DIR/$eng"
  [ -d "$eng_dir" ] || { r "Engagement not found: $eng"; return 1; }

  local report="$eng_dir/report.md"

  c "Exporting timeline report: $eng"

  {
    echo "# Penetration Test Timeline: $eng"
    echo ""

    echo "## Engagement Details"
    echo ""
    while IFS= read -r line; do
      echo "- **$(echo "$line" | cut -d: -f1):** $(echo "$line" | cut -d: -f2-)"
    done < "$eng_dir/meta.txt"
    echo ""

    echo "---"
    echo ""

    if [ -f "$eng_dir/milestones.log" ] && [ -s "$eng_dir/milestones.log" ]; then
      echo "## Key Milestones"
      echo ""
      while IFS= read -r line; do
        echo "- $line"
      done < "$eng_dir/milestones.log"
      echo ""
    fi

    if [ -f "$eng_dir/commands.log" ] && [ -s "$eng_dir/commands.log" ]; then
      echo "## Command Log"
      echo ""
      echo '```'
      cat "$eng_dir/commands.log"
      echo '```'
      echo ""
    fi

    local ss_files=$(ls "$eng_dir"/screenshot-*.txt 2>/dev/null)
    if [ -n "$ss_files" ]; then
      echo "## Screenshots"
      echo ""
      for ss in $ss_files; do
        echo "### $(basename "$ss")"
        echo '```'
        cat "$ss"
        echo '```'
        echo ""
      done
    fi

    echo "---"
    echo "_Report generated by Darknode OS Timeline Recorder_"
  } > "$report"

  g "Report exported: $report"
  echo "  $(wc -l < "$report") lines"
}

cmd_list(){
  c "Recorded Engagements"
  echo ""
  if [ -z "$(ls -A "$DIR" 2>/dev/null | grep -v '^\.')" ]; then
    dim "  No recordings yet. Start one: darknode-timeline start <name>"
    return
  fi

  for d in "$DIR"/*/; do
    [ -d "$d" ] || continue
    local name=$(basename "$d")
    local started=$(grep "started:" "$d/meta.txt" 2>/dev/null | head -1 | cut -d: -f2-)
    local cmds=$(wc -l < "$d/commands.log" 2>/dev/null || echo 0)
    local miles=$(wc -l < "$d/milestones.log" 2>/dev/null || echo 0)
    printf "  %-25s %s  (%d cmds, %d milestones)\n" "$name" "${started:-?}" "$cmds" "$miles"
  done

  echo ""
  if [ -f "$ACTIVE_FILE" ]; then
    g "  Currently recording: $(cat "$ACTIVE_FILE")"
  fi
}

usage(){
  cat << 'USAGE'

  darknode-timeline — Attack Timeline Recorder

  Commands:
    start <name>        Start recording an engagement
    mark <note>         Add a milestone to the current recording
    screenshot          Capture current terminal state
    stop                Stop recording
    replay <name>       Replay a recorded engagement
    export <name>       Export as markdown report
    list                List all recordings

USAGE
}

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  start)      cmd_start "$@" ;;
  mark)       cmd_mark "$*" ;;
  screenshot) cmd_screenshot ;;
  stop)       cmd_stop ;;
  replay)     cmd_replay "$@" ;;
  export)     cmd_export "$@" ;;
  list)       cmd_list ;;
  help|--help|-h) usage ;;
  *)          r "Unknown: $cmd"; usage; exit 1 ;;
esac
