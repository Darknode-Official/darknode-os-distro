_check_tool(){
  local name="$1"
  case "$name" in
    dig) command -v dig >/dev/null 2>&1 ;;
    searchsploit) command -v searchsploit >/dev/null 2>&1 || [ -f /opt/exploitdb/searchsploit ] ;;
    impacket) python3 -c "import impacket" 2>/dev/null ;;
    volatility3) python3 -c "import volatility3" 2>/dev/null || command -v vol >/dev/null 2>&1 ;;
    exiftool) command -v exiftool >/dev/null 2>&1 ;;
    aws) command -v aws >/dev/null 2>&1 ;;
    *) command -v "$name" >/dev/null 2>&1 ;;
  esac
}

cmd_check(){
  local total=0 found=0 missing=0
  local last_cat=""
  for entry in "${TOOLS[@]}"; do
    IFS='|' read -r name cat method pkg <<< "$entry"
    if [ "$cat" != "$last_cat" ]; then
      [ -n "$last_cat" ] && echo ""
      printf "  \e[1;36m%-20s\e[0m\n" "[$cat]"
      last_cat="$cat"
    fi
    total=$((total+1))
    if _check_tool "$name"; then
      printf "    $(g '[ok]') %s\n" "$name"
      found=$((found+1))
    else
      printf "    $(r '[--]') %s  $(dim '(%s %s)')\n" "$name" "$method" "$pkg"
      missing=$((missing+1))
    fi
  done
  echo ""
  echo "  $(g "$found") installed, $(r "$missing") missing, $total total"
  [ "$missing" -gt 0 ] && echo "  Run $(c 'sentinel-toolkit install') to install missing tools."
}

cmd_install(){
  local missing_apt=() missing_pip=() missing_go=()
  for entry in "${TOOLS[@]}"; do
    IFS='|' read -r name cat method pkg <<< "$entry"
    _check_tool "$name" && continue
    case "$method" in
      apt) missing_apt+=("$pkg") ;;
      pip) missing_pip+=("$name") ;;
      go)  missing_go+=("$pkg") ;;
    esac
  done

  if [ ${#missing_apt[@]} -eq 0 ] && [ ${#missing_pip[@]} -eq 0 ] && [ ${#missing_go[@]} -eq 0 ]; then
    g "All tools are installed!"
    echo ""
    return 0
  fi

  echo ""
  c "Installing missing tools..."
  echo ""

  if [ ${#missing_apt[@]} -gt 0 ]; then
    echo "  APT packages: ${missing_apt[*]}"
    sudo apt-get update -y >/dev/null 2>&1
    for pkg in "${missing_apt[@]}"; do
      printf "    Installing %s... " "$pkg"
      if sudo apt-get install -y "$pkg" >/dev/null 2>&1; then
        g "ok"; echo ""
      else
        r "failed"; echo ""
      fi
    done
  fi

  if [ ${#missing_pip[@]} -gt 0 ]; then
    echo "  PIP packages: ${missing_pip[*]}"
    for pkg in "${missing_pip[@]}"; do
      printf "    Installing %s... " "$pkg"
      if pipx install "$pkg" >/dev/null 2>&1 || pip3 install --user "$pkg" >/dev/null 2>&1; then
        g "ok"; echo ""
      else
        r "failed"; echo ""
      fi
    done
  fi

  if [ ${#missing_go[@]} -gt 0 ]; then
    echo "  Go packages: ${missing_go[*]}"
    for pkg in "${missing_go[@]}"; do
      printf "    Installing %s... " "$(basename "$pkg")"
      if go install "$pkg" >/dev/null 2>&1; then
        g "ok"; echo ""
      else
        r "failed"; echo ""
      fi
    done
  fi

  echo ""
  g "Done."
  echo "  Run $(c 'sentinel-toolkit check') to verify."
}

cmd_list(){
  echo ""
  c "Sentinel OS Tool Registry"
  echo ""
  local last_cat=""
  for entry in "${TOOLS[@]}"; do
    IFS='|' read -r name cat method pkg <<< "$entry"
    if [ "$cat" != "$last_cat" ]; then
      [ -n "$last_cat" ] && echo ""
      printf "  \e[1;36m%s\e[0m\n" "=== $cat ==="
      last_cat="$cat"
    fi
    local status="--"
    _check_tool "$name" && status="ok"
    printf "    %-20s %s\n" "$name" "($method: $pkg)"
  done
  echo ""
  echo "  Total: ${#TOOLS[@]} tools"
}

cmd_search(){
  local q="${1:?usage: sentinel-toolkit search <query>}"
  q=$(echo "$q" | tr '[:upper:]' '[:lower:]')
  echo ""
  c "Searching for: $q"
  echo ""
  local found=0
  for entry in "${TOOLS[@]}"; do
    IFS='|' read -r name cat method pkg <<< "$entry"
    if echo "$name $cat $pkg" | tr '[:upper:]' '[:lower:]' | grep -q "$q"; then
      local status; _check_tool "$name" && status="$(g '[ok]')" || status="$(r '[--]')"
      printf "  $status %-20s %-15s %s\n" "$name" "$cat" "($method: $pkg)"
      found=$((found+1))
    fi
  done
  [ "$found" -eq 0 ] && y "  No tools matching '$q'"
  echo ""
}

case "${1:-help}" in
  check)   cmd_check ;;
  install) cmd_install ;;
  list)    cmd_list ;;
  search)  shift; cmd_search "$@" ;;
  *)
    echo ""
    echo "  sentinel-toolkit — manage the hacking toolkit"
    echo ""
    echo "    check      Verify all tools are installed"
    echo "    install    Install missing tools"
    echo "    list       List all tools by category"
    echo "    search <q> Search for a tool"
    echo ""
    ;;
esac
