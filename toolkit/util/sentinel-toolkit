# sentinel-toolkit — verify and install the complete hacking toolkit
#   sentinel-toolkit check      — verify all tools are installed
#   sentinel-toolkit install    — install missing tools
#   sentinel-toolkit list       — list all tools by category
#   sentinel-toolkit search <q> — search for a tool
set -uo pipefail

c(){ printf '\e[1;36m%s\e[0m' "$*"; }
g(){ printf '\e[32m%s\e[0m' "$*"; }
r(){ printf '\e[31m%s\e[0m' "$*"; }
y(){ printf '\e[33m%s\e[0m' "$*"; }
dim(){ printf '\e[2m%s\e[0m' "$*"; }

