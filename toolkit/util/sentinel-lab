#!/usr/bin/env bash
set -uo pipefail
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }

LABS=(
  "dvwa|Docker|Damn Vulnerable Web App|docker run -d --name dvwa -p 8080:80 vulnerables/web-dvwa"
  "juice-shop|Docker|OWASP Juice Shop|docker run -d --name juice-shop -p 3000:3000 bkimminich/juice-shop"
  "webgoat|Docker|OWASP WebGoat|docker run -d --name webgoat -p 8081:8080 -p 9090:9090 webgoat/webgoat"
  "mutillidae|Docker|OWASP Mutillidae II|docker run -d --name mutillidae -p 8082:80 citizenstig/nowasp"
  "hackthebox|Docker|HackTheBox Starting Point|docker run -d --name htb-sp -p 1337:1337 parrotsec/security"
  "metasploitable|QEMU|Metasploitable 2|echo 'Download from: https://sourceforge.net/projects/metasploitable/'"
  "vulnhub|QEMU|VulnHub VMs|echo 'Browse: https://www.vulnhub.com/'"
)

cmd_list(){
  c "Available Practice Labs"
  echo ""
  printf "  %-16s %-8s %s\n" "NAME" "TYPE" "DESCRIPTION"
  printf "  %-16s %-8s %s\n" "---" "---" "---"
  for entry in "${LABS[@]}"; do
    IFS='|' read -r name type desc _ <<< "$entry"
    local running=""
    docker ps --format '{{.Names}}' 2>/dev/null | grep -qx "$name" && running=" (RUNNING)"
    printf "  %-16s %-8s %s%s\n" "$name" "$type" "$desc" "$running"
  done
}

cmd_start(){
  local target="${1:?usage: sentinel-lab start <name>}"
  for entry in "${LABS[@]}"; do
    IFS='|' read -r name type desc cmd <<< "$entry"
    if [ "$name" = "$target" ]; then
      c "Starting $name ($desc)..."
      if [ "$type" = "Docker" ]; then
        command -v docker >/dev/null || { r "Docker not installed."; return 1; }
        docker rm -f "$name" 2>/dev/null
        eval "$cmd"
        g "  $name started!"
        echo "  Access at the mapped port (check: docker ps)"
      else
        eval "$cmd"
      fi
      return
    fi
  done
  r "Unknown lab: $target. Run 'sentinel-lab list' to see options."
}

cmd_stop(){
  c "Stopping all labs..."
  for entry in "${LABS[@]}"; do
    IFS='|' read -r name _ _ _ <<< "$entry"
    docker stop "$name" 2>/dev/null && docker rm "$name" 2>/dev/null && echo "  Stopped: $name"
  done
  g "  All labs stopped."
}

cmd_status(){
  c "Running Labs"
  echo ""
  local running=$(docker ps --format '{{.Names}} {{.Ports}}' 2>/dev/null | head -10)
  [ -n "$running" ] && echo "$running" | sed 's/^/  /' || dim "  No labs running."
}

usage(){ cat << 'U'
  sentinel-lab — spin up vulnerable practice environments

  Commands:
    list              List available labs
    start <name>      Start a lab (Docker or QEMU)
    stop              Stop all running labs
    status            Show running labs
U
}
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  list) cmd_list ;; start) cmd_start "$@" ;; stop) cmd_stop ;; status) cmd_status ;;
  help|--help|-h) usage ;; *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
