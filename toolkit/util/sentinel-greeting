#!/usr/bin/env bash
set -uo pipefail
# Sentinel OS terminal greeting — shows on new terminal

T='\e[38;2;0;234;255m'   # teal
G='\e[38;2;63;185;80m'   # green
P='\e[38;2;176;38;255m'  # purple
D='\e[2m'                 # dim
R='\e[0m'                 # reset
B='\e[1m'                 # bold

# Logo with gradient
echo ""
printf "${T}  ███████${P}███████${T}███╗   ██${P}████████${T}██╗${P}███╗   ██${T}███████${P}██╗     ${R}\n"
printf "${T}  ██╔════${P}██╔════${T}████╗  ██${P}╚══██╔══${T}██║${P}████╗  ██${T}██╔════${P}██║     ${R}\n"
printf "${T}  █████  ${P}█████  ${T}██ ██  ██${P}   ██   ${T}██║${P}██ ██  ██${T}█████  ${P}██║     ${R}\n"
printf "${T}  ██╔══  ${P}██╔══  ${T}██  ██ ██${P}   ██   ${T}██║${P}██  ██ ██${T}██╔══  ${P}██║     ${R}\n"
printf "${T}  ███████${P}███████${T}██   ████${P}   ██   ${T}██║${P}██   ████${T}███████${P}███████ ${R}\n"
printf "  ${D}>_ AI-powered security workstation${R}\n"
echo ""

# System info
CPU=$(grep 'model name' /proc/cpuinfo 2>/dev/null | head -1 | cut -d: -f2 | xargs | cut -c1-40)
RAM=$(free -h 2>/dev/null | awk '/^Mem:/{print $3 "/" $2}')
DISK=$(df -h / 2>/dev/null | awk 'NR==2{print $3 "/" $2}')
IP=$(hostname -I 2>/dev/null | awk '{print $1}')
TOOLS=$(find /usr/bin /usr/sbin /usr/local/bin -maxdepth 1 -type f 2>/dev/null | wc -l)
UP=$(uptime -p 2>/dev/null | sed 's/up //')

printf "  ${D}cpu${R}  ${CPU:-unknown}\n"
printf "  ${D}mem${R}  ${RAM:-?}    ${D}disk${R}  ${DISK:-?}    ${D}up${R}  ${UP:-?}\n"
printf "  ${D}ip${R}   ${IP:-offline}    ${D}tools${R}  ${TOOLS}\n"
echo ""

# Random quote
QUOTES=(
  "The quieter you become, the more you can hear."
  "Hack the planet."
  "There is no patch for human stupidity."
  "Every system has a vulnerability. Find it."
  "Knowledge is power. Especially the kind they don't want you to have."
  "Trust, but verify. Then verify again."
  "The best defense is a good offense."
  "In the world of ones and zeros, you are the variable."
  "Stay curious. Stay dangerous."
  "root@reality:~# whoami"
)
IDX=$((RANDOM % ${#QUOTES[@]}))
printf "  ${D}\"${QUOTES[$IDX]}\"${R}\n"
echo ""
