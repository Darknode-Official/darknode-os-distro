#!/usr/bin/env bash
# sentinel-collab — share files and notes with teammates over a local HTTP server
set -uo pipefail
DIR="$HOME/.sentinel/collab"; mkdir -p "$DIR/shared" "$DIR/notes"
c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }
ts(){ date -u +%Y%m%d-%H%M%S; }

cmd_start(){
  local port="${1:-8888}"
  c "Starting collaboration server on port $port..."
  cd "$DIR" || return 1
  python3 -m http.server "$port" --directory "$DIR" &
  local pid=$!
  echo "$pid" > "$DIR/.server_pid"
  g "  Server running at http://$(hostname -I 2>/dev/null | awk '{print $1}'):$port"
  echo "  Shared files: $DIR/shared/"
  echo "  PID: $pid"
  dim "  Stop with: sentinel-collab stop"
}

cmd_stop(){
  if [ -f "$DIR/.server_pid" ]; then
    kill "$(cat "$DIR/.server_pid")" 2>/dev/null
    rm -f "$DIR/.server_pid"
    g "  Server stopped."
  else
    dim "  No server running."
  fi
}

cmd_share(){
  local file="${1:?usage: sentinel-collab share <file>}"
  [ -f "$file" ] || { r "File not found: $file"; return 1; }
  cp "$file" "$DIR/shared/"
  g "  Shared: $(basename "$file")"
  echo "  Available at: shared/$(basename "$file")"
}

cmd_note(){
  local text="${1:?usage: sentinel-collab note 'message'}"
  echo "[$(ts)] $(whoami): $text" >> "$DIR/notes/board.txt"
  g "  Note added."
}

cmd_board(){
  c "Team Board"
  echo ""
  if [ -f "$DIR/notes/board.txt" ]; then
    cat "$DIR/notes/board.txt" | sed 's/^/  /'
  else
    dim "  No notes yet. Add one: sentinel-collab note 'message'"
  fi
}

cmd_export(){
  local out="$DIR/collab-export-$(ts).tar.gz"
  tar czf "$out" -C "$DIR" shared/ notes/ 2>/dev/null
  g "  Exported: $out"
}

usage(){ cat << 'U'
  sentinel-collab — team collaboration during engagements

  Commands:
    start [port]     Start HTTP file-sharing server (default 8888)
    stop             Stop the server
    share <file>     Share a file with the team
    note <message>   Add a note to the team board
    board            View team board
    export           Export all shared data
U
}
cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  start) cmd_start "$@" ;; stop) cmd_stop ;; share) cmd_share "$@" ;;
  note) cmd_note "$@" ;; board) cmd_board ;; export) cmd_export ;;
  help|--help|-h) usage ;; *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
