#!/usr/bin/env bash
# darknode-tweaks — Darknode control center — toggle modes and system tweaks
# Darknode control center — toggle modes (Predator-OS/kali-tweaks style).
set -uo pipefail
command -v whiptail >/dev/null || { echo "install whiptail"; exit 1; }
while C=$(whiptail --title "Darknode Tweaks" --menu "Mode / action" 20 64 11 \
  anon-on "Route ALL traffic through Tor (+kill-switch)" \
  anon-off "Disable Tor routing" \
  anon-test "Check anonymity (leak test)" \
  stealth "Toggle undercover/stealth desktop" \
  mac "Randomize MAC address" \
  arsenal "Install a tool arsenal group" \
  triage "AI-triage a target" \
  ask "Natural-language command" \
  quit "Exit" 3>&1 1>&2 2>&3); do
  case "$C" in
    anon-on) sudo darknode-anon start;; anon-off) sudo darknode-anon stop;; anon-test) darknode-anon status;;
    stealth) darknode-stealth toggle;; mac) sudo darknode-macspoof random;;
    arsenal) g=$(whiptail --inputbox "group: web/wireless/forensics/recon/crypto/passwords/blue" 8 64 3>&1 1>&2 2>&3) && sudo darknode-arsenal install "$g";;
    triage) t=$(whiptail --inputbox "target ip/domain" 8 60 3>&1 1>&2 2>&3) && darknode-triage "$t";;
    ask) q=$(whiptail --inputbox "what do you want to do?" 8 64 3>&1 1>&2 2>&3) && darknode-ask "$q";;
    quit) break;;
  esac; read -rp "press enter…" _
done
