cmd_library(){
  local subcmd="${1:-browse}"
  shift 2>/dev/null || true

  case "$subcmd" in
    browse|list)
      echo ""
      c "Sentinel Sandbox — Malware Sample Library"
      dim "Educational samples demonstrating real attack techniques."
      dim "All samples are safe scripts that only affect the sandbox."
      echo ""
      printf "  %-28s %-22s %-4s %s\n" "NAME" "CATEGORY" "LVL" "DESCRIPTION"
      printf "  %-28s %-22s %-4s %s\n" "---" "---" "---" "---"
      for entry in "${LIBRARY_SAMPLES[@]}"; do
        IFS='|' read -r name cat desc lvl <<< "$entry"
        local diff=""
        case "$lvl" in
          1) diff="EZ" ;; 2) diff="MED" ;; 3) diff="ADV" ;;
        esac
        printf "  %-28s %-22s %-4s %s\n" "$name" "$cat" "$diff" "$desc"
      done
      echo ""
      echo "  Load a sample:  sentinel-sandbox library load <name>"
      echo "  Then run it:    sentinel-sandbox shell"
      echo "                  /samples/<name>"
      echo ""
      ;;

    load)
      local name="${1:?usage: sentinel-sandbox library load <name>}"
      # Validate the name exists in our library
      local found=false
      for entry in "${LIBRARY_SAMPLES[@]}"; do
        IFS='|' read -r ename _ _ _ <<< "$entry"
        [ "$ename" = "$name" ] && found=true && break
      done
      if ! $found; then
        r "Unknown sample: $name"
        echo "Run 'sentinel-sandbox library' to see available samples."
        return 1
      fi
      _gen_sample "$name"
      if [ -f "$LIBRARY_DIR/$name" ]; then
        cp "$LIBRARY_DIR/$name" "$SAMPLES_DIR/$name"
        chmod +x "$SAMPLES_DIR/$name"
        g "Loaded: $name -> $SAMPLES_DIR/$name"
        if _is_running; then
          echo "  Run inside sandbox: sentinel-sandbox shell"
          echo "  Then:               /samples/$name"
        else
          echo "  Start sandbox first: sentinel-sandbox start"
        fi
      else
        r "Failed to generate sample: $name"
      fi
      ;;

    load-all)
      c "Loading all library samples..."
      for entry in "${LIBRARY_SAMPLES[@]}"; do
        IFS='|' read -r name _ _ _ <<< "$entry"
        _gen_sample "$name"
        cp "$LIBRARY_DIR/$name" "$SAMPLES_DIR/$name" 2>/dev/null
        chmod +x "$SAMPLES_DIR/$name" 2>/dev/null
        echo "  Loaded: $name"
      done
      g "All ${#LIBRARY_SAMPLES[@]} samples loaded."
      ;;

    *) r "Unknown: library $subcmd"; echo "  Use: library [browse|load <name>|load-all]" ;;
  esac
}

# ---- usage ----
usage(){
  cat << 'USAGE'

  sentinel-sandbox — isolated malware analysis playground

  Commands:
    start [--gui]     Launch a fresh, network-isolated sandbox
    shell             Get a shell inside the sandbox
    drop <file>       Copy a sample into the sandbox
    watch             Live monitor: processes, files, network
    snap              Take a filesystem snapshot
    diff              Compare current state vs clean baseline
    report            Generate a behavior analysis report
    destroy           Tear down the sandbox completely
    status            Show sandbox state
    list-samples      List all dropped samples
    library           Browse the built-in malware sample library
    library load <n>  Load a sample from the library
    library load-all  Load all library samples
    network <on|off>  Toggle internet access (off by default)

  Sample Library Categories:
    Persistence       Cron, systemd, bashrc, rc.local backdoors
    Evasion           Process spoofing, timestomping, log cleaning, packing
    Credential Theft  Keyloggers, credential harvesters
    C2 Communication  DNS beacons, HTTP beacons, reverse shells
    Ransomware        File encryption simulation (with decryptor)
    Rootkit           LD_PRELOAD hooking, process injection
    Exfiltration      DNS/HTTP/ICMP/steganography data theft
    Lateral Movement  Worm propagation simulation
    Fileless          Memory-only malware techniques
    Privilege Esc.    SUID backdoors

USAGE
}

# ---- dispatch ----
cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  start)        cmd_start "$@" ;;
  shell)        cmd_shell ;;
  drop)         cmd_drop "$@" ;;
  watch)        cmd_watch ;;
  snap)         cmd_snap ;;
  diff)         cmd_diff ;;
  report)       cmd_report ;;
  destroy)      cmd_destroy ;;
  status)       cmd_status ;;
  list-samples) cmd_list_samples ;;
  library)      cmd_library "$@" ;;
  network)      cmd_network "$@" ;;
  help|--help|-h) usage ;;
  *)            r "Unknown command: $cmd"; usage; exit 1 ;;
esac
