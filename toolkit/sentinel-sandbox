# self-contained scripts that only affect the sandbox. NOT real malware.
LIBRARY_DIR="$SANDBOX_DIR/library"
mkdir -p "$LIBRARY_DIR"

_gen_sample(){
  local name="$1" file="$LIBRARY_DIR/$1"
  [ -f "$file" ] && return
  case "$name" in

  # ---- PERSISTENCE ----
