#!/usr/bin/env bash
set -uo pipefail
# sentinel-iochunt — hunt for indicators of compromise on the local system

IOC_DIR="$HOME/.sentinel/iochunt"
mkdir -p "$IOC_DIR"

c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }

cmd_scan(){
  c "Full System IOC Scan"
  local stamp; stamp=$(date -u +%Y%m%d-%H%M%S)
  local report="$IOC_DIR/scan_${stamp}.txt"
  echo ""

  # 1. Suspicious connections
  echo "=== Suspicious Network Connections ===" | tee "$report"
  ss -tlnp 2>/dev/null | grep -v "127.0.0.1\|::1" | tee -a "$report" | while read -r line; do
    echo "  $line"
  done

  echo "" | tee -a "$report"
  echo "=== Outbound to non-standard ports ===" | tee -a "$report"
  ss -tnp 2>/dev/null | grep ESTAB | awk '{print $5}' | grep -vE ':80$|:443$|:53$|:22$' | sort -u | while read -r conn; do
    y "  Unusual outbound: $conn"
    echo "  $conn" >> "$report"
  done

  # 2. Persistence mechanisms
  echo "" | tee -a "$report"
  echo "=== Persistence Mechanisms ===" | tee -a "$report"
  # Crontabs
  for user in $(cut -d: -f1 /etc/passwd 2>/dev/null); do
    local cron; cron=$(crontab -l -u "$user" 2>/dev/null | grep -v '^#' | grep -v '^$')
    [ -n "$cron" ] && echo "  Crontab ($user): $cron" | tee -a "$report"
  done
  # Systemd services (non-standard)
  find /etc/systemd/system -name '*.service' -newer /etc/os-release 2>/dev/null | while read -r svc; do
    y "  New systemd service: $svc"
    echo "  $svc" >> "$report"
  done
  # rc.local
  [ -f /etc/rc.local ] && [ -s /etc/rc.local ] && y "  rc.local exists and is non-empty" && echo "  rc.local present" >> "$report"
  # SUID binaries in unusual locations
  find /tmp /home /var/tmp -perm -4000 -type f 2>/dev/null | while read -r suid; do
    r "  SUID in temp dir: $suid"
    echo "  SUID: $suid" >> "$report"
  done

  # 3. Suspicious files
  echo "" | tee -a "$report"
  echo "=== Suspicious Files ===" | tee -a "$report"
  find /tmp /dev/shm /var/tmp -name '.*' -type f 2>/dev/null | head -20 | while read -r hf; do
    y "  Hidden file: $hf"
    echo "  $hf" >> "$report"
  done

  # 4. Modified system binaries
  echo "" | tee -a "$report"
  echo "=== Recently Modified System Binaries ===" | tee -a "$report"
  find /usr/bin /usr/sbin /usr/local/bin -mtime -7 -type f 2>/dev/null | while read -r mod; do
    y "  Modified (7d): $mod"
    echo "  $mod" >> "$report"
  done

  echo ""
  g "Scan complete. Report: $report"
}

cmd_check_ip(){
  local ip="${1:?usage: sentinel-iochunt check-ip <ip>}"
  c "IOC Check: IP $ip"
  echo ""
  # AbuseIPDB (free API)
  dim "Checking AbuseIPDB..."
  local abuse; abuse=$(curl -s "https://api.abuseipdb.com/api/v2/check?ipAddress=$ip" \
    -H "Key: ${ABUSEIPDB_KEY:-}" -H "Accept: application/json" 2>/dev/null)
  if echo "$abuse" | python3 -c "import sys,json;d=json.load(sys.stdin);print(f'  Abuse score: {d[\"data\"][\"abuseConfidenceScore\"]}%');print(f'  Reports: {d[\"data\"][\"totalReports\"]}');print(f'  Country: {d[\"data\"][\"countryCode\"]}')" 2>/dev/null; then
    :
  else
    dim "  Set ABUSEIPDB_KEY for reputation check (free at abuseipdb.com)"
  fi
  # VirusTotal
  dim "Checking VirusTotal..."
  if [ -n "${VT_API_KEY:-}" ]; then
    curl -s "https://www.virustotal.com/api/v3/ip_addresses/$ip" -H "x-apikey: $VT_API_KEY" 2>/dev/null | \
      python3 -c "import sys,json;d=json.load(sys.stdin);s=d.get('data',{}).get('attributes',{}).get('last_analysis_stats',{});print(f'  Malicious: {s.get(\"malicious\",0)} | Suspicious: {s.get(\"suspicious\",0)} | Clean: {s.get(\"harmless\",0)}')" 2>/dev/null
  else
    dim "  Set VT_API_KEY for VirusTotal lookup"
  fi
  # Reverse DNS
  echo "  Reverse DNS: $(dig +short -x "$ip" 2>/dev/null || echo 'none')"
  # Whois
  echo "  Owner: $(whois "$ip" 2>/dev/null | grep -iE '^OrgName|^org-name|^netname' | head -1 | sed 's/.*: *//')"
}

cmd_check_hash(){
  local hash="${1:?usage: sentinel-iochunt check-hash <sha256>}"
  c "IOC Check: Hash $hash"
  echo ""
  # MalwareBazaar
  dim "Checking MalwareBazaar..."
  local mb; mb=$(curl -s -X POST "https://mb-api.abuse.ch/api/v1/" -d "query=get_info" -d "hash=$hash" 2>/dev/null)
  echo "$mb" | python3 -c "
import sys,json
d=json.load(sys.stdin)
if d.get('query_status')=='ok' and d.get('data'):
    s=d['data'][0]
    print(f'  Signature: {s.get(\"signature\",\"unknown\")}')
    print(f'  File type: {s.get(\"file_type\",\"?\")}')
    print(f'  First seen: {s.get(\"first_seen\",\"?\")}')
    print(f'  Tags: {s.get(\"tags\",[])}')
else:
    print('  Not found in MalwareBazaar')
" 2>/dev/null
}

cmd_check_domain(){
  local domain="${1:?usage: sentinel-iochunt check-domain <domain>}"
  c "IOC Check: Domain $domain"
  echo ""
  echo "  Resolves to: $(dig +short "$domain" 2>/dev/null | head -3 | tr '\n' ', ')"
  echo "  Registered: $(whois "$domain" 2>/dev/null | grep -i 'creation\|created' | head -1 | sed 's/.*: *//')"
  echo "  Registrar: $(whois "$domain" 2>/dev/null | grep -i 'registrar:' | head -1 | sed 's/.*: *//')"
  # URLhaus
  dim "Checking URLhaus..."
  curl -s -X POST "https://urlhaus-api.abuse.ch/v1/host/" -d "host=$domain" 2>/dev/null | \
    python3 -c "import sys,json;d=json.load(sys.stdin);print(f'  URLhaus: {d.get(\"query_status\",\"?\")} — {d.get(\"urls_online\",0)} active URLs')" 2>/dev/null
}

cmd_persistence(){
  c "Persistence Mechanism Scan"
  echo ""
  dim "Crontabs:"
  crontab -l 2>/dev/null | grep -v '^#' | grep -v '^$' | sed 's/^/  /' || dim "  (empty)"
  echo ""
  dim "Systemd user services:"
  find ~/.config/systemd/user -name '*.service' 2>/dev/null | sed 's/^/  /' || dim "  (none)"
  echo ""
  dim "Startup scripts:"
  ls ~/.config/autostart/*.desktop 2>/dev/null | sed 's/^/  /' || dim "  (none)"
  echo ""
  dim "Shell hooks:"
  for f in ~/.bashrc ~/.bash_profile ~/.profile ~/.zshrc; do
    [ -f "$f" ] && grep -n 'eval\|exec\|nohup\|/dev/tcp\|curl.*|.*sh\|wget.*|.*sh' "$f" 2>/dev/null | while read -r line; do
      y "  $f: $line"
    done
  done
  echo ""
  dim "SUID binaries in user-writable dirs:"
  find /tmp /home /var/tmp /dev/shm -perm -4000 -type f 2>/dev/null | sed 's/^/  /' || dim "  (none)"
}

cmd_connections(){
  c "Suspicious Connection Analysis"
  echo ""
  dim "Established connections to external IPs:"
  ss -tnp 2>/dev/null | grep ESTAB | awk '{print $5,$6}' | grep -v '127.0.0.1\|::1\|10\.\|192\.168\.\|172\.' | sort -u | while read -r line; do
    y "  External: $line"
  done
  echo ""
  dim "Listening services:"
  ss -tlnp 2>/dev/null | grep LISTEN | awk '{print $4,$6}' | sed 's/^/  /'
}

cmd_report(){
  c "IOC Hunt Reports"
  ls -lht "$IOC_DIR"/ 2>/dev/null | head -20 | sed 's/^/  /'
}

usage(){ cat << 'U'

  sentinel-iochunt — indicator of compromise hunter

  Commands:
    scan                   Full system IOC scan
    check-ip <ip>          Check IP reputation (AbuseIPDB, VT)
    check-hash <sha256>    Check hash against MalwareBazaar
    check-domain <domain>  Check domain reputation (URLhaus)
    persistence            Scan for persistence mechanisms
    connections            Analyze suspicious connections
    report                 Show past scan reports

U
}

cmd="${1:-help}"; shift 2>/dev/null || true
case "$cmd" in
  scan) cmd_scan ;; check-ip) cmd_check_ip "$@" ;; check-hash) cmd_check_hash "$@" ;;
  check-domain) cmd_check_domain "$@" ;; persistence) cmd_persistence ;;
  connections) cmd_connections ;; report) cmd_report ;; help|--help|-h) usage ;;
  *) r "Unknown: $cmd"; usage; exit 1 ;;
esac
