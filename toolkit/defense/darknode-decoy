#!/usr/bin/env bash
set -uo pipefail
# darknode-decoy — decoy network generator
# Generates fake but convincing services, files, and credentials to waste attacker time.
#
#   darknode-decoy honeypot ssh 2222       — run fake SSH on port 2222
#   darknode-decoy honeypot http 8080      — run fake HTTP on port 8080
#   darknode-decoy files /shares/          — plant convincing fake files
#   darknode-decoy creds /shares/IT/       — plant fake credential files
#   darknode-decoy status                  — show active decoys
#   darknode-decoy stop                    — stop all decoys

DIR="$HOME/.darknode/decoys"
PIDS_FILE="$DIR/active_pids"
LOG="$DIR/decoy.log"
mkdir -p "$DIR"

c(){ printf '\e[1;36m%s\e[0m\n' "$*"; }
g(){ printf '\e[32m%s\e[0m\n' "$*"; }
y(){ printf '\e[33m%s\e[0m\n' "$*"; }
r(){ printf '\e[31m%s\e[0m\n' "$*"; }
dim(){ printf '\e[2m%s\e[0m\n' "$*"; }

_log(){ echo "[$(date '+%Y-%m-%d %H:%M:%S')] $*" >> "$LOG"; }

cmd_honeypot(){
  local svc="${1:?usage: darknode-decoy honeypot <ssh|http|ftp|telnet|smb> <port>}"
  local port="${2:?missing port}"

  c "Deploying decoy $svc on port $port..."

  case "$svc" in
    ssh)
      # Fake SSH banner that logs connection attempts
      (while true; do
        echo "SSH-2.0-OpenSSH_8.9p1 Ubuntu-3ubuntu0.4" | \
          nc -l -p "$port" -q1 2>/dev/null | while read -r line; do
            _log "SSH_PROBE port=$port from=$(echo "$line" | head -c 100)"
          done
        sleep 0.1
      done) &
      echo "$!" >> "$PIDS_FILE"
      g "Fake SSH running on port $port (PID $!)"
      dim "Banner: OpenSSH_8.9p1 Ubuntu"
      ;;
    http)
      # Fake HTTP server returning a convincing login page
      (while true; do
        {
          echo "HTTP/1.1 200 OK"
          echo "Server: Apache/2.4.57 (Ubuntu)"
          echo "Content-Type: text/html"
          echo ""
          echo "<html><head><title>Admin Panel</title></head><body>"
          echo "<h2>Admin Login</h2>"
          echo "<form method=POST action=/login>"
          echo "<input name=user placeholder=Username><br>"
          echo "<input name=pass type=password placeholder=Password><br>"
          echo "<button>Login</button></form></body></html>"
        } | nc -l -p "$port" -q1 2>/dev/null | while read -r line; do
          _log "HTTP_PROBE port=$port data=$(echo "$line" | head -c 200)"
        done
        sleep 0.1
      done) &
      echo "$!" >> "$PIDS_FILE"
      g "Fake HTTP admin panel on port $port (PID $!)"
      ;;
    ftp)
      (while true; do
        echo "220 ProFTPD 1.3.7 Server ready." | \
          nc -l -p "$port" -q1 2>/dev/null | while read -r line; do
            _log "FTP_PROBE port=$port cmd=$(echo "$line" | head -c 100)"
          done
        sleep 0.1
      done) &
      echo "$!" >> "$PIDS_FILE"
      g "Fake FTP on port $port (PID $!)"
      ;;
    telnet)
      (while true; do
        printf "Ubuntu 22.04 LTS\nlogin: " | \
          nc -l -p "$port" -q1 2>/dev/null | while read -r line; do
            _log "TELNET_PROBE port=$port input=$(echo "$line" | head -c 100)"
          done
        sleep 0.1
      done) &
      echo "$!" >> "$PIDS_FILE"
      g "Fake Telnet on port $port (PID $!)"
      ;;
    *)
      r "Unknown service: $svc. Use: ssh, http, ftp, telnet"
      return 1
      ;;
  esac
  _log "DEPLOYED decoy=$svc port=$port pid=$!"
}

