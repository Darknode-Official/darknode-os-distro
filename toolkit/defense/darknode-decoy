cmd_status(){
  c "Decoy Status"
  echo ""
  local active=0
  if [ -f "$PIDS_FILE" ]; then
    while read -r pid; do
      if kill -0 "$pid" 2>/dev/null; then
        g "  PID $pid: running"
        active=$((active+1))
      else
        dim "  PID $pid: stopped"
      fi
    done < "$PIDS_FILE"
  fi
  echo ""
  echo "  Active decoys: $active"
  echo "  Log entries: $(wc -l < "$LOG" 2>/dev/null || echo 0)"
  echo ""
  if [ -f "$LOG" ]; then
    echo "  Recent alerts:"
    tail -5 "$LOG" | sed 's/^/    /'
  fi
}

cmd_stop(){
  c "Stopping all decoys..."
  if [ -f "$PIDS_FILE" ]; then
    while read -r pid; do
      kill "$pid" 2>/dev/null && echo "  Stopped PID $pid"
    done < "$PIDS_FILE"
    rm -f "$PIDS_FILE"
  fi
  g "All decoys stopped."
  _log "STOPPED all decoys"
}

cmd_alerts(){
  c "Decoy Alerts"
  echo ""
  if [ -f "$LOG" ] && [ -s "$LOG" ]; then
    cat "$LOG" | sed 's/^/  /'
  else
    dim "  No alerts yet."
  fi
}

usage(){
  cat << 'USAGE'

  darknode-decoy — decoy network generator

  Commands:
    honeypot <svc> <port>   Run a fake service (ssh/http/ftp/telnet)
    files <dir>             Plant convincing fake files
    creds <dir>             Plant fake credential files
    status                  Show active decoys and alerts
    alerts                  Show all logged probe attempts
    stop                    Stop all running decoys

  Every connection to a decoy is logged. Any access = attacker.

USAGE
}

cmd="${1:-help}"
shift 2>/dev/null || true

case "$cmd" in
  honeypot)  cmd_honeypot "$@" ;;
  files)     cmd_files "$@" ;;
  creds)     cmd_creds "$@" ;;
  status)    cmd_status ;;
  alerts)    cmd_alerts ;;
  stop)      cmd_stop ;;
  help|--help|-h) usage ;;
  *)         r "Unknown: $cmd"; usage; exit 1 ;;
esac
